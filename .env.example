# Optional: GitHub sign-in. Copy these lines to .env and fill them in.
# From an Auth0 application of type "Single Page Application" with the GitHub
# social connection turned on. In that application, add http://localhost:5173
# and each deployed address to Allowed Callback URLs, Allowed Logout URLs and
# Allowed Web Origins. Without these, sign-in is hidden and everyone reads as a guest.
# Only VITE_ variables reach the browser; never give a secret that prefix.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
