# Optional: GitHub sign-in in local development. Copy these lines to .env
# and fill them in from a GitHub OAuth app registered for local use
# (https://github.com/settings/applications/new), with the callback URL
# http://localhost:5173/api/auth/callback. The Cloudflare Vite plugin gives
# them to the Worker; they never reach the browser (only VITE_ variables do,
# so never give a secret that prefix). Without them, sign-in is hidden.
# In production, GITHUB_CLIENT_ID is a var in wrangler.jsonc and
# GITHUB_CLIENT_SECRET a secret: pnpm exec wrangler secret put GITHUB_CLIENT_SECRET
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
